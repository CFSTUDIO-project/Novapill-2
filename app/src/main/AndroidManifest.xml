<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Required: draw the pill above other apps. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Foreground service (type specialUse) that owns the overlay window. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Screen recorder: the foreground service type that Android 14+ demands for screen capture, and the optional microphone track. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Quick panel status line: is the phone on Wi-Fi, mobile data or offline. Never changes the connection. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Android 13+: show the service notification and the timer-finished notification. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Optional "auto start after reboot". -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Lyrics lookup (opt-in), weather and artwork URLs provided by the media player. HTTPS only. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Optional: weather for the current location. Last known location only, never background. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Android 15+: callback when this app's own windows are visible in a screen recording. -->
    <uses-permission android:name="android.permission.DETECT_SCREEN_RECORDING" />
    <!-- Optional: only for "Hide in selected apps" (user grants Usage access manually). -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <uses-feature android:name="android.hardware.camera.flash" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.location" android:required="false" />

    <queries>
        <!-- Lets the app pickers list launchable apps without QUERY_ALL_PACKAGES. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Optional Shizuku status check. -->
        <package android:name="moe.shizuku.privileged.api" />
    </queries>

    <application
        android:name=".NovaApp"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.NovaPill">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|uiMode|density|fontScale"
            android:exported="true"
            android:label="@string/launcher_name"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Invisible helper that opens the system file picker (Storage Access Framework) for .lrc import. -->
        <activity
            android:name=".ImportLrcActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:taskAffinity=""
            android:theme="@style/Theme.NovaPill.Translucent" />

        <!-- Transparent helper that shows Android's own screen-capture consent dialog, then starts the recorder. -->
        <activity
            android:name=".record.RecordConsentActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:taskAffinity=""
            android:theme="@style/Theme.NovaPill.Translucent" />

        <!-- Small reply box for a message notification that offers a text reply (RemoteInput). -->
        <activity
            android:name=".notif.QuickReplyActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:taskAffinity=""
            android:theme="@style/Theme.NovaPill.Translucent"
            android:windowSoftInputMode="stateVisible|adjustResize" />

        <!--
            Screen recorder. Android 14+ requires the mediaProjection type for screen capture; the microphone type
            is only ever passed at run time when the user allowed the microphone.
        -->
        <service
            android:name=".record.RecorderService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection|microphone" />

        <!--
            Foreground service type: specialUse. NOVA PILL does not play audio or video itself, so
            mediaPlayback would be wrong. The service only owns a user-started overlay window.
        -->
        <service
            android:name=".service.IslandService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps a user-started Dynamic-Island-style overlay pill on screen to show media, timers and notification peeks" />
        </service>

        <service
            android:name=".service.NovaNotificationListener"
            android:exported="true"
            android:label="@string/listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <receiver
            android:name=".service.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".service.TimerReceiver"
            android:exported="false" />

        <!-- Shizuku status only (optional integration; no feature depends on it). -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
    </application>
</manifest>
